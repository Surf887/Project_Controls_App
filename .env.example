# ───────────────────────── Client ─────────────────────────
VITE_API_BASE=/api
# true ONLY for production-like client builds (enables the role switcher + x-pc-role).
# Vite `npm run dev` also shows demo chrome via import.meta.env.DEV even when this is false.
# Server demo auth is a separate flag (DEMO_AUTH / NODE_ENV) — that is what mints tokens.
VITE_DEMO_AUTH=false
# Optional: IdP authorize URL for the "Sign in with SSO" button (must redirect
# back with #id_token=... in the fragment).
# VITE_OIDC_LOGIN_URL=https://your-idp.example.com/authorize?...

# ───────────────────────── Server ─────────────────────────
PORT=3001
# API_PORT overrides PORT for the API server. Set it when the parent process
# injects its own PORT (e.g. dev/preview tooling) so the API keeps its port.
# API_PORT=3001
NODE_ENV=development            # set to "production" for deployments
# Captured at jsonProjectStore.ts import time (before the .env file loader).
# Export it in the shell if you need a non-default path; a .env-only value is ignored.
# Under tsx the default is server/data/projects.json; the bundle defaults to
# <repo>/data/projects.json (../../data from server/dist).
# DATABASE_PATH=./server/data/projects.json

# --- Authentication (required) ---
# Mandatory in production (server refuses to boot without it). Min 16 chars.
JWT_SECRET=change-me-to-a-long-random-string
# SESSION_TTL_SEC is captured at auth.ts import time (before the .env file
# loader). A value that exists only in this file is ignored; export it.
SESSION_TTL_SEC=3600            # session token lifetime (seconds)
# BCRYPT_ROUNDS is captured at userStore.ts import time (same as DATABASE_PATH).
# The in-code default is 12; a .env-only override is ignored.
# BCRYPT_ROUNDS=12

# First-run bootstrap admin (created only if no users exist yet).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Administrator

# Demo auth: accept unauthenticated x-pc-role headers + /auth/token minting.
# Forced OFF in production regardless of this value. If unset, it is ON only
# when NODE_ENV=development. With it on, a missing x-pc-role is cost_controller
# and the SPA auto-mints POST /api/platform/auth/token.
# The Vite role switcher also appears in DEV even when VITE_DEMO_AUTH=false.
DEMO_AUTH=false

# --- Authorization ---
# Require project membership to access a project (prevents cross-project IDOR).
# Defaults to true when NODE_ENV=production.
# ENFORCE_PROJECT_MEMBERSHIP=true

# --- OIDC / SSO (optional) ---
# Set issuer + client id to enable SSO login (POST /api/platform/auth/oidc).
# OIDC_ISSUER=https://your-idp.example.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_JWKS_URI=                 # defaults to <issuer>/.well-known/jwks.json
# OIDC_DEFAULT_ROLE=viewer       # role granted to users on first SSO login

# --- HTTP hardening ---
# CORS allowlist (comma-separated). Required in production; cross-origin is
# denied if unset in production.
# CORS_ORIGIN=https://controls.example.com
# RATE_LIMIT_PER_MIN=300
# JSON_LIMIT=1mb
# DISABLE_RATE_LIMIT=false        # bypass rate limiting (tests/local only)
# JWT_ISSUER=project-controls     # iss claim. Captured at jwt.ts import time —
#                                  must be in the process env (Compose injects it).
#                                  A value that exists only in this file is ignored.
# SERVE_CLIENT=true               # API serves the built client (set false behind a CDN/proxy)

# Set when TLS terminates at a reverse proxy (true = 1 hop, or a hop count).
# TRUST_PROXY=true

# --- Integrity & secrets at rest ---
# Reserved for a future HMAC-keyed audit chain. The current writer
# (server/src/services/auditService.ts) uses unkeyed SHA-256 and does not read this.
# AUDIT_HMAC_SECRET=change-me-to-a-long-random-string
# AES-256-GCM key for encrypting connector OAuth tokens at rest. If unset,
# connectorCrypto falls back to JWT_SECRET. Compose does not pass this unless you add it.
# CREDENTIALS_KEY=change-me-to-a-long-random-string
# Shared secret for verifying inbound webhook HMAC signatures (or per-connector
# WEBHOOK_SECRET_<CONNECTOR>). Not a boot-time fail-fast: missing secret → 401 on
# inbound webhooks in production. Unsigned requests are allowed in non-prod.
# WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- OIDC client secret ---
# Not read by the current ID-token exchange (JWKS verify in oidc.ts).
# Reserved if you later add Authorization-Code + PKCE.
# OIDC_CLIENT_SECRET=your-client-secret

# --- Observability ---
LOG_LEVEL=info                    # info | warn | error
# LOG_LEVEL is honoured by server/src/utils/logger.ts. That helper is not wired
# into request middleware today (no x-request-id). Compose does not pass LOG_LEVEL.

# --- Postgres (optional — enterprise persistence; REQUIRED in production) ---
# In production the server refuses to start without DATABASE_URL (the JSON file
# store is not durable enough for production).
# DATABASE_URL=postgres://pc:pc@localhost:5432/project_controls

# --- Env file locations ---
# Vite (client) always reads this file from the repo root.
# API loadRootEnvFile() does not override existing process env.
#   tsx (npm run dev:server)  → server/.env
#   bundled server/dist/index.js → repo-root .env
# Docker Compose injects selected vars into the container (see DEPLOYMENT.md).

# --- Misc (testing) ---
# USERS_PATH=./server/data/users.json   # rejected in production; also import-time (see DATABASE_PATH)
# AUDIT_DIR is read at call time (does pick up this file). Bundled default without
# AUDIT_DIR is <repo>/data/audit, not server/data/audit.
# AUDIT_DIR=./server/data/audit
