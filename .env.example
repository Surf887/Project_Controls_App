# ───────────────────────── Client ─────────────────────────
VITE_API_BASE=/api
# true ONLY for local demos (enables the role switcher + x-pc-role header).
# Leave false for any real build so the client uses real login tokens.
VITE_DEMO_AUTH=false
# Explicit opt-in for browser-only demos when the API is unavailable.
# Production builds default to fail closed instead of exposing local seed data.
VITE_ALLOW_OFFLINE=false
# Optional demo-only modules backed by simulated/illustrative data.
# Keep false in production.
VITE_ENABLE_SIMULATED_FEATURES=false
# Optional: IdP authorize URL for the "Sign in with SSO" button (must redirect
# back with #id_token=... in the fragment).
# VITE_OIDC_LOGIN_URL=https://your-idp.example.com/authorize?...

# ───────────────────────── Server ─────────────────────────
PORT=3001
# API_PORT overrides PORT for the API server. Set it when the parent process
# injects its own PORT (e.g. dev/preview tooling) so the API keeps its port.
# API_PORT=3001
NODE_ENV=development            # set to "production" for deployments
DATABASE_PATH=./server/data/projects.json

# --- Authentication (required) ---
# Mandatory in production (server refuses to boot without it). Min 16 chars.
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL_SEC=3600            # session token lifetime (seconds)
BCRYPT_ROUNDS=12

# First-run bootstrap admin (created only if no users exist yet).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Administrator
# Used only when production starts against an empty projects database.
BOOTSTRAP_PROJECT_NAME=New Capital Project
# BOOTSTRAP_PROJECT_ID=proj-capital-001

# Demo auth: accept unauthenticated x-pc-role headers + /auth/token minting.
# Forced OFF in production regardless of this value.
DEMO_AUTH=false
# Enables sample connector responses in non-production development only.
ENABLE_SIMULATED_INTEGRATIONS=false

# --- Authorization ---
# Require project membership to access a project (prevents cross-project IDOR).
# Defaults to true when NODE_ENV=production.
# ENFORCE_PROJECT_MEMBERSHIP=true

# --- OIDC / SSO (optional) ---
# Set issuer + client id to enable SSO login (POST /api/platform/auth/oidc).
# OIDC_ISSUER=https://your-idp.example.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_JWKS_URI=                 # defaults to <issuer>/.well-known/jwks.json
# OIDC_DEFAULT_ROLE=viewer       # role granted to users on first SSO login

# --- HTTP hardening ---
# CORS allowlist (comma-separated). Required in production; cross-origin is
# denied if unset in production.
# CORS_ORIGIN=https://controls.example.com
# RATE_LIMIT_PER_MIN=300
# JSON_LIMIT=1mb
# DISABLE_RATE_LIMIT=false        # bypass rate limiting (tests/local only)
# JWT_ISSUER=project-controls     # iss claim on issued/verified session tokens
# SERVE_CLIENT=true               # API serves the built client (set false behind a CDN/proxy)

# --- Integrity & secrets at rest (required in production) ---
# HMAC key for the tamper-evident audit chain. Required in production.
# AUDIT_HMAC_SECRET=change-me-to-a-long-random-string
# AES-256-GCM key for encrypting connector OAuth tokens at rest. Required in production.
# CREDENTIALS_KEY=change-me-to-a-long-random-string
# Shared secret for verifying inbound webhook HMAC signatures (or per-connector
# WEBHOOK_SECRET_<CONNECTOR>). Required in production to accept webhooks.
# WEBHOOK_SECRET=change-me-to-a-long-random-string
# AES-GCM source-document encryption key. Required in production.
DOCUMENT_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Private malware scanner endpoint (for example a ClamAV gateway). Required in production.
DOCUMENT_SCAN_ENDPOINT=http://clamav-gateway:8080/scan
# DOCUMENT_SCAN_TOKEN=change-me-to-a-long-random-string

# --- OCR providers ---
# Privacy-first local is the default. Text-layer PDFs/text are processed in-process.
# Scanned PDFs/images can use a private local service or local Tesseract language data.
OCR_DEFAULT_PROVIDER=local
# OCR_LOCAL_ENDPOINT=http://docling:5001/ocr
# OCR_LOCAL_TOKEN=change-me-to-a-long-random-string
# OCR_LOCAL_TESSDATA_PATH=/opt/tessdata
# OCR_LOCAL_LANGUAGE=eng
# Optional Azure AI Document Intelligence
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# AZURE_DOCUMENT_INTELLIGENCE_KEY=...
# Optional AWS Textract (standard AWS credential chain)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# --- Snowflake cost-data source (OAuth or key-pair recommended) ---
# SNOWFLAKE_ACCOUNT=org-account
# SNOWFLAKE_USERNAME=project_controls_reader
# SNOWFLAKE_WAREHOUSE=PC_WH
# SNOWFLAKE_DATABASE=CURATED
# SNOWFLAKE_SCHEMA=PROJECT_CONTROLS
# SNOWFLAKE_ROLE=PC_READ_ONLY
# SNOWFLAKE_OAUTH_TOKEN=...
# SNOWFLAKE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=...
# Password auth is disabled in production unless explicitly enabled:
# SNOWFLAKE_PASSWORD=...
# SNOWFLAKE_ALLOW_PASSWORD_AUTH=false

# --- OIDC client secret (if your exchange flow requires it) ---
# OIDC_CLIENT_SECRET=your-client-secret

# --- Observability ---
LOG_LEVEL=info                    # info | warn | error
# Optional protected Prometheus endpoint at GET /api/metrics (min 16 chars).
# METRICS_TOKEN=change-me-to-a-long-random-string
# Reverse-proxy hops trusted for client IP/rate limiting (usually 1).
# TRUST_PROXY=1

# --- Postgres (optional — enterprise persistence; REQUIRED in production) ---
# In production the server refuses to start without DATABASE_URL (the JSON file
# store is not durable enough for production).
# DATABASE_URL=postgres://pc:pc@localhost:5432/project_controls
# DATABASE_SSL=true                 # enable for managed PostgreSQL
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECT_TIMEOUT_MS=10000
# DB_STATEMENT_TIMEOUT_MS=30000

# --- Misc (testing) ---
# USERS_PATH=./server/data/users.json
# AUDIT_DIR=./server/data/audit
